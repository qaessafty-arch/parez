{
  "name": "parez",
  "version": "1.0.0",
  "private": true,
  "description": "Parez - Shop Accounting & Payment Management System (Akre, Kurdistan Region)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test \"server/test/*.test.js\"",
    "typecheck": "tsc -p client/tsconfig.json --noEmit",
    "migrate": "node server/src/db/migrate.js",
    "seed": "node server/src/db/seed.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
