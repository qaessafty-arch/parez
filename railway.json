{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "on_failure"
  },
  "environments": {
    "production": {
      "variables": {
        "NODE_ENV": "production",
        "PAREZ_DATA_DIR": "/app/data"
      }
    }
  }
}