# parez - Production Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git!

# =============================================================================
# Application
# =============================================================================
NODE_ENV=production
DATABASE_URL=file:./data/parez.db
COOKIE_SECURE=1
SESSION_TTL_HOURS=24

# =============================================================================
# Backup (Encryption & S3/Wasabi/B2)
# =============================================================================
BACKUP_PASS=your-32-char-random-passphrase-here
S3_BUCKET=your-backup-bucket-name
S3_ENDPOINT=https://s3.wasabisys.com
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# =============================================================================
# Domain & SSL (for certbot/nginx)
# =============================================================================
DOMAIN=parez.yourdomain.com
EMAIL=admin@yourdomain.com

# =============================================================================
# GitHub Actions / CI/CD
# =============================================================================
VPS_HOST=your-vps-ip
VPS_SSH_KEY=your-private-ssh-key